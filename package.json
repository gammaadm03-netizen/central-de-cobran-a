{
  "name": "central-financeira",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test supabase/functions/auth-gateway/*.test.mjs supabase/functions/payables-import/*.test.mjs supabase/functions/receivables-import/*.test.mjs config/*.test.mjs src/lib/*.test.mjs",
    "test:browser": "playwright test",
    "test:sql": "node scripts/test-sql.mjs",
    "test:auth-sql": "node scripts/test-auth-sql.mjs",
    "test:payables-sql": "node scripts/test-payables-sql.mjs",
    "test:treasury-sql": "node scripts/test-treasury-sql.mjs",
    "test:director-sql": "node scripts/bundle-finance.mjs && node scripts/test-director-sql.mjs",
    "test:receivables-sql": "node scripts/test-receivables-sql.mjs",
    "test:collections-sql": "node scripts/test-collections-sql.mjs",
    "test:bank-import-sql": "node scripts/test-bank-import-sql.mjs",
    "test:treasury-accounts-sql": "node scripts/test-treasury-accounts-sql.mjs",
    "test:upgrade-sql": "node scripts/bundle-receivables.mjs && node scripts/test-upgrade-sql.mjs",
    "bundle:finance": "node scripts/bundle-finance.mjs",
    "bundle:payables-gateway": "node scripts/bundle-payables-gateway.mjs",
    "bundle:receivables": "node scripts/bundle-receivables.mjs",
    "bundle:receivables-gateway": "node scripts/bundle-receivables-gateway.mjs",
    "bundle:gateway": "node scripts/bundle-gateway.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
