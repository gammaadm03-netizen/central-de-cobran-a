    "test:receivable-received-import-sql": "node scripts/test-receivable-received-import-sql.mjs",
    "test:collections-management-sql": "node scripts/test-collections-management-sql.mjs",
    "test:collection-workbench-sql": "node scripts/test-collection-workbench-sql.mjs",
    "bundle:receivables-operations": "node scripts/bundle-receivables-operations.mjs",
