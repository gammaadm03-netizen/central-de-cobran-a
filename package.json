    "test:commercial-sql": "node scripts/test-commercial-sql.mjs",
    "test:hr-sql": "node scripts/test-hr-sql.mjs",
    "test:commissions-sql": "node scripts/test-commissions-sql.mjs",
    "test:remaining-modules-sql": "node scripts/test-remaining-modules-sql.mjs",
    "test:hr-report-model-sql": "node scripts/test-hr-report-model-sql.mjs",
