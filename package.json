{
  "name": "central-financeira",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test supabase/functions/auth-gateway/*.test.mjs config/*.test.mjs",
    "test:browser": "playwright test",
    "test:sql": "node scripts/test-sql.mjs",
    "test:auth-sql": "node scripts/test-auth-sql.mjs",
    "bundle:gateway": "node scripts/bundle-gateway.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
