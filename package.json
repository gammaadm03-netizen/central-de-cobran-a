    "test:payable-payments-sql": "node scripts/test-payable-payments-sql.mjs",
    "test:payable-identity-sql": "node scripts/test-payable-identity-sql.mjs",
    "test:payable-closing-sql": "node scripts/test-payable-closing-sql.mjs",
